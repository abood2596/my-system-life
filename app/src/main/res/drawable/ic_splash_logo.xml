    <!-- rays -->
    <path android:pathData="M54,12 V24" android:strokeColor="#FFD9A0" android:strokeWidth="2.4" android:strokeLineCap="round" android:strokeAlpha="0.9" />
    <path android:pathData="M28,22 L36,33" android:strokeColor="#FFD9A0" android:strokeWidth="2.4" android:strokeLineCap="round" android:strokeAlpha="0.9" />
    <path android:pathData="M80,22 L72,33" android:strokeColor="#FFD9A0" android:strokeWidth="2.4" android:strokeLineCap="round" android:strokeAlpha="0.9" />
    <path android:pathData="M14,46 L25,52" android:strokeColor="#FFD9A0" android:strokeWidth="2.4" android:strokeLineCap="round" android:strokeAlpha="0.9" />
    <path android:pathData="M94,46 L83,52" android:strokeColor="#FFD9A0" android:strokeWidth="2.4" android:strokeLineCap="round" android:strokeAlpha="0.9" />

    <!-- rising sun -->
    <path android:pathData="M28,68 A26,26 0 0 1 80,68 Z">
        <aapt:attr name="android:fillColor">
            <gradient android:type="radial" android:centerX="54" android:centerY="68" android:gradientRadius="30">
                <item android:offset="0" android:color="#FFF1C9" />
                <item android:offset="0.55" android:color="#FFC56F" />
                <item android:offset="1" android:color="#FF8A5B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- horizon -->
    <path android:pathData="M22,68 H86" android:strokeColor="#FFD9A0" android:strokeWidth="3" android:strokeLineCap="round" />
