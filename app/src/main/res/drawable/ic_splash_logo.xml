    <!-- faint 8-point Islamic star -->
    <path
        android:pathData="M30,30 H78 V78 H30 Z"
        android:strokeColor="#FFD9A0" android:strokeWidth="1.6" android:strokeAlpha="0.25" android:fillColor="#00000000" />
    <group android:rotation="45" android:pivotX="54" android:pivotY="54">
        <path
            android:pathData="M30,30 H78 V78 H30 Z"
            android:strokeColor="#FFD9A0" android:strokeWidth="1.6" android:strokeAlpha="0.25" android:fillColor="#00000000" />
