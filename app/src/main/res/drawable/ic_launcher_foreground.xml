<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- faint 8-point Islamic star (Rub el Hizb) -->
    <group android:name="star">
        <path
            android:pathData="M33,33 H75 V75 H33 Z"
            android:strokeColor="#FFD9A0"
            android:strokeWidth="2"
            android:strokeAlpha="0.30"
            android:fillColor="#00000000" />
        <group android:rotation="45" android:pivotX="54" android:pivotY="54">
            <path
                android:pathData="M33,33 H75 V75 H33 Z"
                android:strokeColor="#FFD9A0"
                android:strokeWidth="2"
                android:strokeAlpha="0.30"
                android:fillColor="#00000000" />
        </group>
    </group>

    <!-- rising sun rays -->
    <group android:name="rays">
        <path android:pathData="M54,18 V28" android:strokeColor="#FFD9A0" android:strokeWidth="2.4" android:strokeLineCap="round" android:strokeAlpha="0.9" />
        <path android:pathData="M32,27 L39,36" android:strokeColor="#FFD9A0" android:strokeWidth="2.4" android:strokeLineCap="round" android:strokeAlpha="0.9" />
        <path android:pathData="M76,27 L69,36" android:strokeColor="#FFD9A0" android:strokeWidth="2.4" android:strokeLineCap="round" android:strokeAlpha="0.9" />
        <path android:pathData="M20,47 L29,52" android:strokeColor="#FFD9A0" android:strokeWidth="2.4" android:strokeLineCap="round" android:strokeAlpha="0.9" />
        <path android:pathData="M88,47 L79,52" android:strokeColor="#FFD9A0" android:strokeWidth="2.4" android:strokeLineCap="round" android:strokeAlpha="0.9" />
    </group>

    <!-- the rising sun (half-disc above the horizon) -->
    <path android:pathData="M30,66 A24,24 0 0 1 78,66 Z">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="54"
                android:centerY="66"
                android:gradientRadius="28">
                <item android:offset="0" android:color="#FFF1C9" />
                <item android:offset="0.55" android:color="#FFC56F" />
                <item android:offset="1" android:color="#FF8A5B" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- horizon line -->
    <path
        android:pathData="M24,66 H84"
        android:strokeColor="#FFD9A0"
        android:strokeWidth="3"
        android:strokeLineCap="round" />
</vector>
