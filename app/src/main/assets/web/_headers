# تَسَابِيح ∞ v21 — Netlify Headers
# يمنع CDN من تخزين sw.js مؤقتاً → يضمن وصول التحديثات فوراً

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache
  Expires: 0

/index.html
  Cache-Control: no-cache, no-store, must-revalidate
  Pragma: no-cache

/manifest.json
  Cache-Control: no-cache, no-store, must-revalidate

/js/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=3600

/icons/*
  Cache-Control: public, max-age=604800, immutable
